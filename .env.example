# ==============================================================================
# Nader Singer & Music Producer - Environment Configuration Template
# Copy this file to .env and configure for your deployment target
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=production

# Administrative Security & Credentials
# Set a strong, private administrator password for your deployed environment
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_EMAIL=nader@nadergator.com
RECOVERY_KEY=your_master_recovery_key_here

# Persistent Storage & Database Directories (Optional)
# If left empty: defaults to ./data on standard hosts, and /tmp/nader_data on serverless
# DATA_DIR=/path/to/data
# UPLOADS_DIR=/path/to/uploads

# Client-Side API Base URL (Optional)
# Leave EMPTY if frontend and backend are hosted on the same domain or Netlify Functions.
# If frontend is on Netlify and backend is on Render/Railway/Fly.io, set your backend URL here:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

# AI Studio Runtime Keys (Injected automatically in AI Studio Build)
GEMINI_API_KEY=""
APP_URL=""
